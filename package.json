{
  "name": "quran-sunnah-companion",
  "version": "2.2.0",
  "description": "Browser extension with Qur'an recitation, hadith from Sahih al-Bukhari and Sahih Muslim, and dhikr reminders in a popup.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "check-sync": "node scripts/check-sync.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint:chrome": "web-ext lint --source-dir=chrome --self-hosted",
    "lint:firefox": "web-ext lint --source-dir=firefox",
    "build:chrome": "web-ext build --source-dir=chrome --artifacts-dir=. --overwrite-dest --ignore-files \"**/*.md\" --filename=\"chrome-build.zip\"",
    "build:firefox": "web-ext build --source-dir=firefox --artifacts-dir=. --overwrite-dest --ignore-files \"**/*.md\" --filename=\"firefox-build.zip\""
  },
  "devDependencies": {
    "web-ext": "10.7.0"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
